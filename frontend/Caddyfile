# SDT_DOMAIN: public hostname (e.g. tesoreria.smalldev.es) -> automatic HTTPS.
# Set SDT_DOMAIN=":80" to serve plain HTTP behind a load balancer (ALB, App Runner…).
# SDT_API_UPSTREAM: where the backend listens (default "api:8000").
{$SDT_DOMAIN::80} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
	handle /api/* {
		reverse_proxy {$SDT_API_UPSTREAM:api:8000}
	}
	handle /health {
		reverse_proxy {$SDT_API_UPSTREAM:api:8000}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
