# --- Platform ---------------------------------------------------------------------------
SDT_ENV=prod
# 32+ random chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SDT_JWT_SECRET=
SDT_CORS_ORIGINS=["https://tesoreria.smalldev.es"]
SDT_SYNC_INTERVAL_SECONDS=900

# --- Public hostname --------------------------------------------------------------------
# With a DNS record pointing here, Caddy gets a Let's Encrypt certificate automatically.
# Behind an existing nginx/ALB on this server, use SDT_DOMAIN=:80 and map SDT_HTTP_PORT=8088.
SDT_DOMAIN=tesoreria.smalldev.es
SDT_HTTP_PORT=80
SDT_HTTPS_PORT=443

# --- Database (existing PostgreSQL server; see setup-db.sql) -----------------------------
# Same host as Docker: host.docker.internal. RDS: its endpoint.
SDT_DATABASE_URL=postgresql+psycopg://sdt_app:CHANGE_ME@host.docker.internal:5432/sdtreasury
SDT_MIGRATION_DATABASE_URL=postgresql+psycopg://sdtreasury:CHANGE_ME@host.docker.internal:5432/sdtreasury

# --- Secrets for each client (referenced as env:NAME from the platform) ------------------
ODOO_SMALLDEV_API_KEY=
ODOO_SMALLDEV_SSO_SECRET=
