<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_open_platform" model="ir.actions.server">
        <field name="name">Treasury</field>
        <field name="model_id" ref="model_sd_treasury_launcher"/>
        <field name="state">code</field>
        <field name="code">action = model.sd_treasury_open()</field>
    </record>

    <menuitem id="menu_sd_treasury_root"
              name="Treasury"
              parent="account_accountant.menu_accounting"
              action="action_open_platform"
              groups="group_sd_treasury_user"
              sequence="3"/>
</odoo>
