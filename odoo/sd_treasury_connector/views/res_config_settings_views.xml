<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sd_treasury</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="SD Treasury" name="sd_treasury_settings">
                    <setting string="SD Treasury platform"
                             help="Web address of the SD Treasury app opened from the Treasury menu">
                        <field name="sd_treasury_platform_url" placeholder="https://tesoreria.smalldev.es"/>
                    </setting>
                    <setting string="Client identifier and login secret"
                             help="Both are provided by SmallDev when the client is registered"
                             groups="base.group_system">
                        <field name="sd_treasury_tenant" placeholder="smalldev"/>
                        <field name="sd_treasury_sso_secret" password="True"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
